# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: SQLite database file path (or PostgreSQL URL when migrated to Prisma/Postgres)
DATABASE_PATH="./data/myconcrete.db"

# Admin Authentication (Set your own strong owner credentials before first launch)
JWT_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional SMTP Email Notifications (Nodemailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MY CONCRETE Dispatch <myconcretektl@gmail.com>"
OWNER_ALERT_EMAIL="myconcretektl@gmail.com"

# Optional Google Tag Manager
VITE_GTM_ID=""
