# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: SQLite database file path (or PostgreSQL URL when migrated to Prisma/Postgres)
DATABASE_PATH="./data/myconcrete.db"

# Admin Authentication (Set your own strong owner credentials before first launch)
JWT_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Lead Notification Email Address (editable in /admin -> Settings -> Notifications)
NOTIFY_EMAIL="myconcretektl@gmail.com"

# Gmail SMTP Email Notifications (Nodemailer - smtp.gmail.com, port 465, secure: true)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MY CONCRETE Dispatch <myconcretektl@gmail.com>"

# Optional Resend HTTP Email API (Alternative to Gmail SMTP)
RESEND_API_KEY=""
RESEND_FROM="MY CONCRETE <onboarding@resend.dev>"

# Pluggable WhatsApp Alerts: cloudapi | twilio | callmebot | none
WHATSAPP_PROVIDER="callmebot"
OWNER_WHATSAPP="917337807372"
# Optional second owner / dispatch manager WhatsApp number (receives same alert)
OWNER_WHATSAPP_2=""

# CallMeBot (Free WhatsApp alerts when WHATSAPP_PROVIDER=callmebot)
CALLMEBOT_PHONE="917337807372"
CALLMEBOT_APIKEY=""

# Meta WhatsApp Cloud API (when WHATSAPP_PROVIDER=cloudapi)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE_NAME=""

# Twilio WhatsApp (when WHATSAPP_PROVIDER=twilio)
TWILIO_SID=""
TWILIO_TOKEN=""
TWILIO_FROM=""

# Optional Google Tag Manager
VITE_GTM_ID=""

# Supabase Backend Integration (https://supabase.com)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Optional: Add service role key only on server if updating existing rows from admin
SUPABASE_SERVICE_ROLE_KEY=""

